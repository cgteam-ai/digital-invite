# BETA environment — copy to ~/beta/.env ON THE SERVER and fill in.
#
#   cd ~/beta && cp .env.beta.example .env && nano .env
#
# ── This is a THIRD .env, and none of them meet ───────────────────────────────
#
#   Your PC's .env     → the local stack (docker-compose.yml)
#   ~/app/.env         → production  (docker-compose.prod.yml)
#   ~/beta/.env        → beta        (docker-compose.beta.yml)   ← this file
#
# .env is gitignored, so none of them are in the repository and none travel when the server
# clones. Editing one changes that stack only.
#
# Generate SEPARATE secrets here. Beta runs code that has not been through production review,
# and sharing a password between the two would make beta's blast radius production's.

# ── Images ────────────────────────────────────────────────────────────────────
# Beta runs the RELEASE branch. build-images.yml tags every build with its branch name
# (type=ref,event=branch), so a build run from release publishes ":release".
#
# ":latest" exists only on the default branch — pointing beta at :latest would silently run
# production's image while the git clone sat on release code, which is the exact mistake this
# whole beta step is meant to catch.
API_IMAGE=ghcr.io/cgteam-ai/digital-invite-api:release
WEB_IMAGE=ghcr.io/cgteam-ai/digital-invite-web:release

# For a reproducible beta, or to re-test an earlier build, pin the commit instead:
#   API_IMAGE=ghcr.io/cgteam-ai/digital-invite-api:sha-<full 40-char commit sha>

# ── Database ──────────────────────────────────────────────────────────────────
# Beta's OWN database, in its own volume. Never point this at production: migrations run on
# boot and this project has no down-migration path, so a beta deploy would silently upgrade
# production's schema to unreleased code.
POSTGRES_DB=invitationplatform
POSTGRES_USER=invitation_beta
# Generate, do not invent:  openssl rand -base64 32
POSTGRES_PASSWORD=GENERATE_A_DIFFERENT_LONG_RANDOM_STRING

# "db" is the compose service name, which resolves inside this stack's own network — it reaches
# invitation-beta-db, not production's. SSL Mode=Disable is correct: the connection never leaves
# the private network.
ConnectionStrings__DefaultConnection="Host=db; Port=5432; Database=invitationplatform; Username=invitation_beta; Password=SAME_AS_POSTGRES_PASSWORD_ABOVE; SSL Mode=Disable;"

# ── Super Admin ───────────────────────────────────────────────────────────────
# Seeded on first boot only. A DIFFERENT password from production — beta's admin panel is
# reachable from the internet at beta.digital-invite.net.
SuperAdmin__Email=you@yourdomain.com
SuperAdmin__Password=GENERATE_A_DIFFERENT_STRONG_PASSWORD
SuperAdmin__FirstName=Super
SuperAdmin__LastName=Admin

# ── Email notifications ───────────────────────────────────────────────────────
# Deliberately left OFF for beta. Demo requests still appear in Admin → Requests with an unread
# badge — nothing is lost — and an empty Host means a test submission can never send a real
# email to a real inbox, or burn the production sender's reputation on test traffic.
Smtp__Host=

# ── Hardening ─────────────────────────────────────────────────────────────────
# Rejects requests carrying an unexpected Host header.
AllowedHosts=beta.digital-invite.net

# Cross-origin access. Leave EMPTY: the pages and the API share an origin.
# Cors__AllowedOrigins__0=https://beta.digital-invite.net

# ── NOTE: no SITE_ADDRESS here ────────────────────────────────────────────────
# Beta has no Caddy of its own — only one process can hold ports 80/443, and production's Caddy
# already does. It serves beta.digital-invite.net as a second site block and reaches this
# stack's web container over the shared "invitation-edge" network.
#
# The hostname therefore belongs in PRODUCTION's .env, not here:
#
#   ~/app/.env:  BETA_SITE_ADDRESS=beta.digital-invite.net
#
# then reload production's Caddy so it requests a certificate for the new name:
#
#   cd ~/app && docker compose -f docker-compose.prod.yml \
#     exec -T caddy caddy reload --config /etc/caddy/Caddyfile </dev/null
