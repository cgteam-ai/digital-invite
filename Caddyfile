# Edge server for production: terminates TLS and forwards everything to the web container.
#
# SITE_ADDRESS comes from .env and decides the mode:
#   :80                                        → plain HTTP, for rehearsing locally
#   digital-invite.net, www.digital-invite.net → Caddy obtains and renews Let's Encrypt
#                                                certificates for both names itself
#
# Switching between them is a .env edit plus "docker compose restart caddy" — no certificate
# files to manage and no certbot cron.
{
	# Where Let's Encrypt sends expiry and problem notices. Not required, but without it you
	# get no warning if renewal ever starts failing.
	email {$ACME_EMAIL:admin@digital-invite.net}
}

{$SITE_ADDRESS} {
	encode zstd gzip

	# ── Canonical host ───────────────────────────────────────────────────────
	# Serve one address, not two. Without this, every page is reachable at both the apex and
	# www, which splits search ranking and makes shared invitation links inconsistent.
	#
	# Matching on the Host header rather than on the site address means this rule is simply
	# inert during a local rehearsal, where SITE_ADDRESS is ":80" and no request carries that
	# host. One Caddyfile, both modes.
	@www host www.digital-invite.net
	redir @www https://digital-invite.net{uri} permanent

	# ── Baseline security headers ────────────────────────────────────────────
	header {
		# Stop browsers guessing a content type other than the one we send.
		X-Content-Type-Options "nosniff"
		# Invitations should never be framed by another site.
		X-Frame-Options "SAMEORIGIN"
		# Send the origin, not the full path, when following an outbound link — guest slugs
		# live in the path and should not leak to Google Maps or a registry site.
		Referrer-Policy "strict-origin-when-cross-origin"
		# Do not advertise the server software.
		-Server
	}

	# HSTS is deliberately left off until the certificate has been working for a while.
	# Browsers cache it for its full max-age, so enabling it before you are confident in the
	# TLS setup can lock visitors out of a site you cannot quickly fix. To enable later, add:
	#   header Strict-Transport-Security "max-age=31536000; includeSubDomains"

	# ── Application ──────────────────────────────────────────────────────────
	# All routing — static files, the /api proxy, /invite rewrites — lives in the web
	# container's nginx.conf, so it stays identical between local and production. Caddy is
	# only the TLS edge and deliberately duplicates none of it.
	# Addressed by CONTAINER name, not the compose service name "web".
	#
	# This matters the moment a second stack exists on this host. Compose adds the service name
	# as a DNS alias on EVERY network the service joins, and this Caddy sits on two: the prod
	# network and the shared edge. A beta stack whose service was also called "web" put a second
	# "web" alias on the edge — and Docker resolved it in preference to production's, so every
	# request to digital-invite.net was answered by the beta container, against the beta
	# database. Measured 8 out of 8 before this change.
	#
	# Container names are unique across the whole daemon, so they cannot collide this way.
	reverse_proxy invitation-prod-web:80

	log {
		output stdout
		format console
	}
}

# ── Beta ─────────────────────────────────────────────────────────────────────
# The release branch, on this same server, behind this same Caddy — only one process can hold
# ports 80 and 443, so beta cannot have a Caddy of its own.
#
# BETA_SITE_ADDRESS comes from the PRODUCTION .env (docker-compose.prod.yml passes it to this
# container). It defaults to beta.localhost, which keeps this block parseable on a server with
# no beta: nothing on the internet resolves there, so no public certificate is ever requested.
# Set it to beta.digital-invite.net once the DNS record exists and Caddy obtains a certificate
# for it on the next restart.
#
# The upstream is addressed by CONTAINER NAME, not a compose service name: these two stacks are
# separate compose projects, so "web" here would resolve to production's web container. The beta
# web container joins the shared invitation-edge network precisely so this line can find it.
{$BETA_SITE_ADDRESS:beta.localhost} {
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
		# Beta runs unreleased code against throwaway data. Keeping it out of search results
		# avoids a half-finished feature being indexed under the brand, and avoids beta pages
		# competing with production's for the same queries.
		X-Robots-Tag "noindex, nofollow"
	}

	reverse_proxy invitation-beta-web:80

	log {
		output stdout
		format console
	}
}
